{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": [
    "temurin-bin-25@25.0.4",
    "git@2.55.0"
  ],
  "env": {
    "GRADLE_USER_HOME": "${DEVBOX_PROJECT_ROOT}/.gradle",
    "GRADLE_OPTS": "-Xmx2g"
  },
  "shell": {
    "init_hook": [
      "export JAVA_HOME=$(dirname $(dirname $(readlink -f $(which java))))",
      "echo \"idle-shutdown · java $(java -version 2>&1 | head -1) · $(./gradlew --version 2>&1 | grep '^Gradle')\""
    ],
    "scripts": {
      "build": [
        "./gradlew build"
      ],
      "test": [
        "./gradlew test"
      ],
      "run-ide": [
        "./gradlew runIde"
      ],
      "buildPlugin": [
        "./gradlew buildPlugin"
      ],
      "verify": [
        "./gradlew verifyPlugin"
      ],
      "clean": [
        "./gradlew clean"
      ]
    }
  }
}
